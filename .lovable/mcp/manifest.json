            "low_stock_only": {
              "default": false,
              "description": "Only return items at or below their reorder level.",
              "type": "boolean"
            },
            "limit": {
              "default": 50,
              "description": "Maximum number of items to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
