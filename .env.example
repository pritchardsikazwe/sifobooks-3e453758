# SifoBooks Cloud production configuration
# Copy to .env and replace every placeholder with a real secret/value.

NODE_ENV=production
PORT=3000

SIFOBOOKS_MODE=cloud
SIFOBOOKS_DATABASE=postgres

POSTGRES_DB=sifobooks
POSTGRES_USER=sifobooks
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_URL=postgres://sifobooks:replace-with-a-long-random-password@postgres:5432/sifobooks
POSTGRES_TLS=false
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT=30
POSTGRES_CONNECTION_TIMEOUT=10

JWT_SECRET=replace-with-a-long-random-secret

# Local hardware/VSDC settings are normally used by Windows clients, not Cloud.
VITE_WINDOWS_PRINT_AGENT_URL=http://127.0.0.1:17890
VITE_ANDROID_PRINT_AGENT_URL=http://127.0.0.1:17891
ZRA_VSDC_URL=http://127.0.0.1:8085
ZRA_VSDC_TIMEOUT_MS=15000
