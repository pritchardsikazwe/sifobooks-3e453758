# SifoBooks configuration
# Copy to .env for local development. Never commit real secrets.

DATABASE_PATH=data/sifobooks.db
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
NODE_ENV=production

# Optional local print agents
VITE_WINDOWS_PRINT_AGENT_URL=http://127.0.0.1:17890
VITE_ANDROID_PRINT_AGENT_URL=http://127.0.0.1:17891
ZRA_VSDC_URL=http://127.0.0.1:8085
ZRA_VSDC_TIMEOUT_MS=15000

# Cloud control plane (PostgreSQL)
SIFOBOOKS_MODE=offline
SIFOBOOKS_DATABASE=sqlite
POSTGRES_URL=postgres://sifobooks:sifobooks@127.0.0.1:5432/sifobooks
POSTGRES_TLS=false
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT=30
POSTGRES_CONNECTION_TIMEOUT=10
